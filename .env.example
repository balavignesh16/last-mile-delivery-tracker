# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ---- Application ----
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---- PostgreSQL ----
# DB_HOST=localhost is correct when running the backend directly on the
# host (`go run ./cmd/server`) against the dockerized database exposed on
# DB_PORT below. When the backend itself runs inside Docker Compose,
# docker-compose.yml overrides DB_HOST to the "postgres" service name —
# you do not need to change this value for that case.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lastmile
DB_USER=lastmile
DB_PASSWORD=change_me
DB_SSLMODE=disable
