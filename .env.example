# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ---- Application ----
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---- PostgreSQL ----
# DB_HOST=localhost is correct when running the backend directly on the
# host (`go run ./cmd/server`) against the dockerized database exposed on
# DB_PORT below. When the backend itself runs inside Docker Compose,
# docker-compose.yml overrides DB_HOST to the "postgres" service name —
# you do not need to change this value for that case.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lastmile
DB_USER=lastmile
DB_PASSWORD=change_me
DB_SSLMODE=disable

# ---- Authentication ----
# Signs and verifies JWTs. Use a long, random value in any environment that
# isn't your own machine. Never commit a real secret here — this file only
# ships a placeholder.
JWT_SECRET=change-me-in-development

# ---- CORS ----
# Comma-separated list of exact origins allowed to call this API from a
# browser (e.g. https://your-frontend.vercel.app). Leave unset/empty for
# local dev — Vite's own proxy (frontend/vite.config.ts) already makes
# frontend->backend calls same-origin, so no CORS header is needed there.
# Required only once the frontend is deployed on a different origin than
# this backend.
CORS_ALLOWED_ORIGINS=

# ---- Notifications (M11) ----
# EmailProvider selection. "log" (default) writes the notification to
# the backend's own logs and sends nothing externally — safe with zero
# configuration, including in an evaluator's environment. Set to
# "resend" to send real email via https://resend.com's free tier; if
# you do, RESEND_API_KEY and RESEND_FROM_EMAIL are both then required
# (the backend fails fast at startup if either is missing while
# EMAIL_PROVIDER=resend). SMS stays log-only regardless — see
# docs/notifications.md for why.
EMAIL_PROVIDER=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=
