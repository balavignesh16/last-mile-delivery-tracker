# Copy this file to .env and fill in real values, if needed.
# .env is gitignored — never commit it.

# Optional, build-time API origin (e.g. https://your-backend.onrender.com).
# Leave unset for local dev — Vite's own proxy (vite.config.ts) already
# forwards /api/* and /health to the local backend, so requests stay
# same-origin and no base URL is needed. Set this only when deploying the
# frontend to a different origin than the backend (see docs/deployment.md
# and the root .env.example's CORS_ALLOWED_ORIGINS, which the backend must
# also be given the exact matching origin for).
VITE_API_BASE_URL=
